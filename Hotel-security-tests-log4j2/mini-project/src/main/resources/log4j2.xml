<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss} %-5level %-30logger{1} - %msg%n</Property>
        <Property name="LOG_FILE">logs/hotel.log</Property>
    </Properties>

    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <File name="FileAppender" fileName="${LOG_FILE}" append="true">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </File>
    </Appenders>

    <Loggers>
        <!--
            Covers EVERY class under service/ at once (HotelService, RoomService,
            ReservationService, GuestService, GuestProfileService, ReportService)
            because Log4j2 logger names are hierarchical: this matches this
            package and everything under it. Change this one level to control
            all six classes together.
        -->
        <Logger name="de.lhind.internship.mini.project.service" level="TRACE" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!--
            Dedicated entry for the exception package (GlobalExceptionHandler),
            same reasoning as service above: gives it its own real LoggerConfig
            instead of falling back to shared Root, so its level can be
            controlled independently and test tooling can target it directly.
        -->
        <Logger name="de.lhind.internship.mini.project.exception" level="TRACE" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- Everything else (controllers, security, Spring/Tomcat internals) falls back here -->
        <Root level="INFO">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Root>
    </Loggers>
</Configuration>